{
    "name": "electrik/slate",
    "description": "A shadcn/ui clone for Laravel Blade - Beautiful, accessible components built with Tailwind CSS v4",
    "keywords": [
        "laravel",
        "blade",
        "components",
        "tailwind",
        "shadcn",
        "ui",
        "design-system"
    ],
    "authors": [
        {
            "name": "neerajsohal",
            "email": "hello@neerajkumar.name"
        }
    ],
    "version": "2.0.0-b3",
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "blade-ui-kit/blade-icons": "^1.8",
        "codeat3/blade-carbon-icons": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6",
        "phpunit/phpunit": "^12.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Electrik\\Slate\\Tests\\": "tests/"
        }
    },
    "autoload": {
        "psr-4": {
            "Electrik\\Slate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Electrik\\Slate\\SlateServiceProvider"
            ]
        }
    }
}
