{
    "name": "electrik/slate",
    "description": "A shadcn-inspired Blade UI kit for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Electrik\\Slate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Electrik\\Slate\\SlateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
